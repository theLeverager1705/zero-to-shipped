{
  "name": "anchor",
  "private": true,
  "version": "1.0.0",
  "description": "Anchor, the family co-pilot for Gen Alpha: kids, parents and teachers on one shared plan.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch api/dev.ts\" \"vite\"",
    "build": "npm run typecheck && vite build && node scripts/build-api.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "synth": "cdk synth",
    "deploy": "npm run build && cdk bootstrap && cdk deploy --require-approval never --outputs-file cdk-outputs.json && node scripts/smoke.mjs",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.8",
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/lib-dynamodb": "^3.1141.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.271.0",
    "concurrently": "^10.0.5",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
